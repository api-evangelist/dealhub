  "info": {
    "_postman_id": "ea3068a2-487f-4bfb-bed4-9858db95d1cc",
    "name": "Pricing API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "This API provides services to calculate prices for a given list of product SKUs. It involves a two-step process:\n1.  **Get Products Parameters:** First, call the `/api/v1/products/parameters` endpoint with a list of SKUs to determine the specific \"product factors\" and \"parameters\" required to calculate a price for each one.\n2.  **Get Products Pricing:** Next, call the `/api/v1/products/pricing` endpoint, providing the SKUs along with the required parameters (and their values) obtained from the first call. This will return the calculated price for each SKU.\n\nAll requests require a secret Bearer Token in the `Authorization` header.",
      "type": "text/plain"
    }
  }
